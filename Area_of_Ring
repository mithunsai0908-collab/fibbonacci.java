package uniflow;
import java.util.Scanner;
public class Area_of_Ring {

	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		double r1=sc.nextInt();//outer circle
		double r2=sc.nextInt();//inner circle
		System.out.println("area of circle="+(Math.PI*r1*r1-Math.PI*r2*r2));
		sc.close();
	}

}
